<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Lock Screen Settings"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Owner Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Owner Name"
        android:textColor="#a0a0b0"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/ownerName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/pin_background"
        android:hint="e.g. John Doe"
        android:textColor="#ffffff"
        android:textColorHint="#666680"
        android:textSize="16sp"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <!-- Owner Phone -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency Phone"
        android:textColor="#a0a0b0"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/ownerPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/pin_background"
        android:hint="+255 6XX XXX XXX"
        android:textColor="#ffffff"
        android:textColorHint="#666680"
        android:textSize="16sp"
        android:inputType="phone"
        android:layout_marginBottom="16dp"/>

    <!-- Owner Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lock Screen Message"
        android:textColor="#a0a0b0"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/ownerMessage"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/pin_background"
        android:hint="e.g. This device is tracked. Call me to unlock."
        android:textColor="#ffffff"
        android:textColorHint="#666680"
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="24dp"/>

    <!-- PIN Code -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unlock PIN Code"
        android:textColor="#a0a0b0"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/unlockPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/pin_background"
        android:hint="4-8 digit PIN (leave empty for no PIN)"
        android:textColor="#ffffff"
        android:textColorHint="#666680"
        android:textSize="16sp"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/pinStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#22c55e"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="SAVE SETTINGS"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#0066cc"/>

</LinearLayout>
