<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:gravity="center"
    android:padding="32dp">

    <!-- Lock Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="72sp"
        android:layout_marginBottom="24dp"/>

    <!-- Title -->
    <TextView
        android:id="@+id/lockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE LOCKED"
        android:textColor="#ff4757"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/lockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This device is tracked by TrackMyDevice"
        android:textColor="#a0a0b0"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <!-- Owner Info -->
    <TextView
        android:id="@+id/lockOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Locked by: Admin"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/lockMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Call owner to unlock"
        android:textColor="#8888aa"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <!-- PIN Input -->
    <EditText
        android:id="@+id/pinInput"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:background="@drawable/pin_background"
        android:hint="Enter PIN to unlock"
        android:textColorHint="#666680"
        android:textColor="#ffffff"
        android:textSize="20sp"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Unlock Button -->
    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:text="UNLOCK"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#0066cc"
        android:layout_marginBottom="16dp"/>

    <!-- Emergency Call -->
    <Button
        android:id="@+id/btnEmergency"
        android:layout_width="280dp"
        android:layout_height="44dp"
        android:text="EMERGENCY CALL"
        android:textColor="#ff4757"
        android:textSize="13sp"
        android:backgroundTint="#2a2a3e"
        android:layout_marginBottom="16dp"/>

    <!-- Error message -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#ff4757"
        android:textSize="14sp"
        android:visibility="gone"/>

</LinearLayout>
